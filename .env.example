APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Production uses `single,telegram` so failures reach a human instead of only
# storage/logs. Leave as `single` locally.
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Failure alerting. Create a bot with @BotFather, add it to the alert group,
# then read the chat id from https://api.telegram.org/bot<token>/getUpdates
# (group ids are negative). Unset = the channel is inert, so this is safe to
# leave blank locally and in CI.
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
# Anything at this level or above is alerted on. `error` catches uncaught 500s
# and every Log::error in the app; `critical` narrows it to settlement timeouts.
LOG_TELEGRAM_LEVEL=error
# One alert per distinct message per window, so a hot failure loop cannot flood
# the chat into being muted.
TELEGRAM_ALERT_THROTTLE_SECONDS=300
TELEGRAM_ALERT_TIMEOUT=5

# Scheduler dead-man's switch — base ping URL, e.g. https://hc-ping.com/<ping-key>
# The watchdog alerts when the ping stops, which is how a dead cron gets noticed.
HEALTHCHECKS_PING_URL=

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Firebase Cloud Messaging
FIREBASE_CREDENTIALS_PATH=firebase-key.json
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_ENABLED=true

# 2D result provider (see config/services.php -> twod). Use TWOD_DRIVER=set to
# settle from the SET pipeline instead of thaistock2d, or TWOD_DRIVER=htayapi
# for the htayapi.com API, which also backs the live ticker served by
# GET /api/v1/two-d-results/live.
TWOD_DRIVER=thaistock2d
THAISTOCK2D_URL=https://api.thaistock2d.com/live
THAISTOCK2D_TIMEOUT=20
HTAYAPI_URL=https://htayapi.com/mm-twod/thai/2dlive
HTAYAPI_KEY=replace_with_provided_key
HTAYAPI_TIMEOUT=20
# Internal circuit breaker, not the vendor quota. Sized for a 30,000/day key.
HTAYAPI_DAILY_LIMIT=8000
# Live-ticker cache TTLs in seconds: around the draws, rest of the session,
# and overnight. These alone determine upstream cost — it does not grow with
# the number of users, because every client reads the same cached snapshot.
HTAYAPI_LIVE_TTL_HOT=5
HTAYAPI_LIVE_TTL_WARM=20
HTAYAPI_LIVE_TTL_COLD=300
# Read-only 3D history list (GET /three-d-results/history). Draws land on the
# 1st and 16th, so an hour of staleness costs nothing. Shares the budget above.
HTAYAPI_3D_HISTORY_URL=https://htayapi.com/mm-twod/thai/3dhistory
HTAYAPI_3D_HISTORY_TTL=3600
# Current 3D draw (GET /three-d-results/live). Shorter TTL than the history list
# because the admin dashboard shows it behind a refresh button.
HTAYAPI_3D_LIVE_URL=https://htayapi.com/mm-twod/thai/3dlive
HTAYAPI_3D_LIVE_TTL=60

# SET-index scraper / Myanmar 2D pipeline (see config/set.php)
SET_NODE_BINARY=node
# SET_SCRAPER_PATH=/abs/path/to/scripts/set-scraper/set-capture.mjs  # defaults to base_path()
SET_PROCESS_TIMEOUT=180
# Comma-separated Y-m-d Thai SET holidays; overrides the config default list
SET_HOLIDAYS=
# Comma-separated marketStatus values that abort storage (leave empty)
SET_ABORT_MARKET_STATUSES=
